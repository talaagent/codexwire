#!/usr/bin/env bash
# Compare offline generation with the committed wire types without changing the tree.
set -euo pipefail
cd "$(dirname "$0")/.."
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
python3 -I scripts/gen-codex-protocol.py schema/codex_app_server_protocol.schemas.json \
  schema/VERSION "$tmp/generated.rs"
rustfmt --edition 2024 "$tmp/generated.rs"
generated=crates/codexwire-protocol/src/generated.rs
if ! cmp -s "$generated" "$tmp/generated.rs"; then
  diff -u --label "$generated" --label regenerated "$generated" "$tmp/generated.rs" >&2 || true
  echo "check-codegen: generated files differ; run scripts/gen-codex-protocol and review the diff" >&2
  exit 1
fi
echo "check-codegen: ok"
